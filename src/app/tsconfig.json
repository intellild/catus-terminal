{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "target": "ES2022",
    "rootDir": "../..",
    "tsBuildInfoFile": "../../.tmp/typecheck/app.tsbuildinfo"
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/**/*.ts",
    "../../config/**/*.json",
    "../../native/*.d.ts",
    "../../native/*.d.cts"
  ]
}
