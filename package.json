{
  "name": "catus-terminal",
  "version": "0.0.1",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "format": "rs format '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "format:check": "rs format --check '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "format:cpp": "node scripts/format-cpp.mjs",
    "format:cpp:check": "node scripts/format-cpp.mjs --check",
    "lint": "rs lint",
    "lint:fix": "rs lint --fix",
    "dev": "cross-env NODE_ENV=development concurrently -k --prefix none \"rspeedy dev --environment lynx\" \"dev-ready-rspeedy && rsbuild dev --environment desktop\"",
    "build": "rspeedy build --environment lynx && rsbuild build --environment desktop",
    "start": "pnpm run build && lynxtron dist/desktop",
    "test": "rstest",
    "test:rust": "node scripts/test-rust.mjs",
    "test:napi": "node scripts/test-napi.mjs",
    "pack": "pnpm run build && lynxtron-builder --publish never",
    "build:native": "pnpm --filter @catus/native run build",
    "predev": "node scripts/prepare-dev.mjs && pnpm run build:native",
    "prebuild": "pnpm run build:native",
    "tsc": "tsc --build tsconfig.json",
    "typecheck": "pnpm run tsc",
    "test:unit": "pnpm run test && pnpm run test:node",
    "test:node": "rstest run --config rstest.node.config.ts",
    "test:e2e": "pnpm run build && rstest run --config rstest.e2e.config.ts",
    "test:e2e:windowless": "cross-env CATUS_E2E_WINDOWLESS=1 pnpm run test:e2e",
    "test:e2e:windowed": "cross-env CATUS_E2E_WINDOWLESS=0 pnpm run test:e2e",
    "test:e2e:update": "cross-env CATUS_UPDATE_SCREENSHOTS=1 pnpm run test:e2e",
    "dev:web": "cross-env CATUS_WEB=1 rspeedy dev --environment web",
    "build:web": "cross-env CATUS_WEB=1 rspeedy build --environment web",
    "test:native-input": "node scripts/test-native-input.mjs"
  },
  "private": true,
  "devDependencies": {
    "@lynx-js/config-rsbuild-plugin": "latest",
    "@lynx-js/lynx-core": "latest",
    "@lynx-js/lynxtron": "0.0.30",
    "@lynx-js/lynxtron-builder": "0.0.30",
    "@lynx-js/lynxtron-dev-plugins": "0.0.30",
    "@lynx-js/preact-devtools": "latest",
    "@lynx-js/react": "latest",
    "@lynx-js/react-rsbuild-plugin": "latest",
    "@lynx-js/rspeedy": "latest",
    "@lynx-js/tailwind-preset": "^0.6.0",
    "@lynx-js/type-config": "latest",
    "@lynx-js/types": "latest",
    "@resvg/resvg-js": "^2.6.2",
    "@rsbuild/core": "2.2.9",
    "@rsbuild/plugin-type-check": "latest",
    "@rstest/core": "^0.11.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/node": "26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.24",
    "agent-lynx": "0.14.2",
    "compressing": "^1.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "rstack": "^0.8.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@catus/native": "workspace:*",
    "@effect/atom-react": "4.0.0",
    "@formatjs/intl-getcanonicallocales": "^2.5.6",
    "@formatjs/intl-locale": "^4.2.13",
    "@formatjs/intl-pluralrules": "^5.4.6",
    "@hookform/resolvers": "^5.9.1",
    "@lynx-js/lynx-ui-checkbox": "^3.139.0",
    "@lynx-js/lynx-ui-input": "^3.139.0",
    "@lynx-js/lynx-ui-popover": "^3.139.0",
    "background-only": "0.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0",
    "i18next": "^24.2.3",
    "react": "19.2.4",
    "react-hook-form": "^7.90.0",
    "react-i18next": "~15.4.1",
    "scheduler": "0.27.0",
    "tailwind-merge": "^2.6.1"
  },
  "packageManager": "pnpm@10.34.4"
}
