{
  "name": "catus-terminal",
  "version": "0.0.1",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k --prefix none \"rspeedy dev --environment lynx\" \"dev-ready-rspeedy && rsbuild dev --environment desktop\"",
    "build": "rspeedy build --environment lynx && rsbuild build --environment desktop",
    "start": "npm run build && lynxtron dist/desktop",
    "test": "rstest",
    "test:rust": "node scripts/test-rust.mjs",
    "test:napi": "node scripts/test-napi.mjs",
    "pack": "npm run build && lynxtron-builder --publish never",
    "build:native": "npm run build --workspace @catus/native",
    "predev": "node scripts/prepare-dev.mjs && npm run build:native",
    "prebuild": "npm run build:native",
    "typecheck": "tsc --noEmit -p src/app/tsconfig.json && tsc --noEmit -p src/main/desktop/tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "private": true,
  "devDependencies": {
    "@lynx-js/config-rsbuild-plugin": "latest",
    "@lynx-js/lynx-core": "latest",
    "@lynx-js/lynxtron": "0.0.28",
    "@lynx-js/lynxtron-builder": "0.0.28",
    "@lynx-js/lynxtron-dev-plugins": "0.0.28",
    "@lynx-js/preact-devtools": "latest",
    "@lynx-js/react": "latest",
    "@lynx-js/react-rsbuild-plugin": "latest",
    "@lynx-js/rspeedy": "latest",
    "@lynx-js/type-config": "latest",
    "@lynx-js/types": "latest",
    "@rsbuild/core": "2.1.5",
    "@rsbuild/plugin-type-check": "latest",
    "@rstest/core": "^0.11.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/react": "^18.3.24",
    "compressing": "^1.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "workspaces": [
    "native"
  ],
  "dependencies": {
    "@catus/native": "file:native"
  }
}
