{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2023"],
    "target": "ES2022",
    "types": ["node"],
    "tsBuildInfoFile": "./.tmp/typecheck/tools.tsbuildinfo"
  },
  "include": [
    "./lynx.config.ts",
    "./rstest.config.ts",
    "./rstest.e2e.config.ts",
    "./rstest.node.config.ts",
    "./tests/**/*.ts",
    "./src/shared/sftp.ts",
    "./src/shared/sftpBridge.ts",
    "./src/app/api/SftpClient.ts",
    "./src/main/desktop/sftpService.ts",
    "./src/main/desktop/fileTransfers.ts",
    "./rsbuild.config.ts",
    "./tailwind.config.ts",
    "./rstack.config.ts"
  ]
}
