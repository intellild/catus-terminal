{
  "name": "@catus/native-input",
  "version": "0.0.1",
  "description": "macOS native NSTextField custom element for Lynxtron",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./lynxtron": "./lynxtron/index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lynxtron",
    "shared",
    "generated",
    "src",
    "types",
    "lynx.lib.json",
    "README.md"
  ],
  "scripts": {
    "codegen": "lynx-autolink-codegen",
    "build:lynxtron": "cmake -S lynxtron -B build/lynxtron -DCMAKE_BUILD_TYPE=Release -DLYNX_NATIVE_ELEMENT_BACKEND=native-ui && cmake --build build/lynxtron --config Release"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "^0.6.0",
    "@lynx-js/lynx-library-headers": "0.0.28",
    "@lynx-js/weak-node-api": "^0.0.9"
  },
  "private": true,
  "peerDependencies": {
    "@lynx-js/types": "^4.3.0"
  }
}
