{
  "name": "@catus/native-input",
  "version": "0.0.1",
  "description": "macOS native NSTextField custom element for Lynxtron",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./lynxtron": {
      "types": "./types/lynxtron.d.cts",
      "default": "./lynxtron/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lynxtron",
    "shared",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/build.rs",
    "rust/src",
    "generated",
    "src",
    "types",
    "lynx.lib.json",
    "README.md"
  ],
  "scripts": {
    "codegen": "lynx-autolink-codegen",
    "build:lynxtron": "node lynxtron/build.mjs"
  },
  "napi": {
    "binaryName": "native-input"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "^0.6.0",
    "@lynx-js/lynx-library-headers": "0.0.28",
    "@lynx-js/weak-node-api": "^0.0.9",
    "@napi-rs/cli": "^3.10.5"
  },
  "private": true,
  "peerDependencies": {
    "@lynx-js/types": "^4.3.0"
  }
}
